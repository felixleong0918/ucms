rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed(){return request.auth != null;}
  function admin(){return signed() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));}
  function member(c){return signed() && exists(/databases/$(database)/documents/clubs/$(c)/members/$(request.auth.uid));}
  function role(c){return get(/databases/$(database)/documents/clubs/$(c)/members/$(request.auth.uid)).data.role;}
  function staff(c){return admin() || (member(c) && role(c) in ['core','officer','finance']);}
  function core(c){return admin() || (member(c) && role(c)=='core');}
  function finance(c){return admin() || (member(c) && role(c) in ['core','finance']);}
  function module(c,m){return get(/databases/$(database)/documents/clubs/$(c)).data.modules[m] == true;}
  function text(s,max){return s is string && s.size()<=max;}
  function title(s){return s is string && s.size()>0 && s.size()<=200;}
  function stamp(){return request.resource.data.createdAt is int && request.resource.data.updatedAt is int && request.resource.data.createdBy is string;}
  function createStamp(){return stamp() && request.resource.data.createdBy == request.auth.uid;}
  function updateStamp(){return stamp() && request.resource.data.createdBy==resource.data.createdBy && request.resource.data.createdAt==resource.data.createdAt;}
  function clubValid(){let d=request.resource.data;return d.keys().hasOnly(['name','description','modules','createdAt','updatedAt','createdBy']) && title(d.name) && text(d.description,2000) && d.modules.keys().hasOnly(['inventory','timer','feedback']) && d.modules.inventory is bool && d.modules.timer is bool && d.modules.feedback is bool;}
  match /admins/{uid}{allow get:if signed() && (request.auth.uid==uid || admin());allow list:if admin();allow write:if false;}
  match /users/{uid}{allow read:if signed() && (request.auth.uid==uid || admin());allow create,update:if signed() && request.auth.uid==uid && request.resource.data.keys().hasOnly(['name','email']) && title(request.resource.data.name) && request.resource.data.email==request.auth.token.email;allow delete:if false;}
  match /clubs/{c}{
   allow read:if true;
   allow create:if admin() && clubValid() && createStamp();
   allow update:if core(c) && clubValid() && updateStamp();
   allow delete:if false;
   match /members/{uid}{
    allow read:if staff(c) || (signed() && request.auth.uid==uid);
    allow create,update:if core(c) && request.resource.data.keys().hasOnly(['name','email','role']) && title(request.resource.data.name) && request.resource.data.email is string && request.resource.data.role in ['core','officer','finance','member'] && exists(/databases/$(database)/documents/users/$(uid)) && (admin() || uid != request.auth.uid);
    allow delete:if core(c) && uid!=request.auth.uid;
   }
   match /announcements/{id}{
    function valid(){let d=request.resource.data;return d.keys().hasOnly(['title','body','pinned','createdAt','updatedAt','createdBy']) && title(d.title) && text(d.body,20000) && d.pinned is bool;}
    allow read:if staff(c);allow create:if staff(c)&&valid()&&createStamp();allow update:if staff(c)&&valid()&&updateStamp();allow delete:if staff(c);
    match /reads/{uid}{allow read:if staff(c);allow create,update:if staff(c)&&uid==request.auth.uid&&request.resource.data.keys().hasOnly(['readAt'])&&request.resource.data.readAt is int;allow delete:if false;}
   }
   match /tasks/{id}{
    function valid(){let d=request.resource.data;return d.keys().hasOnly(['title','description','assigneeId','dueDate','status','meetingId','createdAt','updatedAt','createdBy']) && title(d.title) && text(d.description,10000) && d.assigneeId is string && exists(/databases/$(database)/documents/clubs/$(c)/members/$(d.assigneeId)) && d.dueDate is string && d.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && d.status in ['todo','doing','done'] && text(d.meetingId,100);}
    allow read:if staff(c) || (member(c)&&resource.data.assigneeId==request.auth.uid);
    allow create:if staff(c)&&valid()&&createStamp();
    allow update:if valid()&&updateStamp()&&(staff(c)||(member(c)&&resource.data.assigneeId==request.auth.uid&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])));
    allow delete:if staff(c);
   }
   match /meetings/{id}{
    function valid(){let d=request.resource.data;return d.keys().hasOnly(['title','date','attendees','content','decisions','createdAt','updatedAt','createdBy'])&&title(d.title)&&text(d.date,10)&&text(d.attendees,2000)&&text(d.content,40000)&&text(d.decisions,20000);}
    allow read:if staff(c);allow create:if staff(c)&&valid()&&createStamp();allow update:if staff(c)&&valid()&&updateStamp();allow delete:if staff(c);
   }
   match /events/{e}{
    function event(){return get(/databases/$(database)/documents/clubs/$(c)/events/$(e)).data;}
    function valid(){let d=request.resource.data;return d.keys().hasOnly(['title','description','location','startAt','endAt','registrationDeadline','fee','published','createdAt','updatedAt','createdBy'])&&title(d.title)&&text(d.description,20000)&&text(d.location,500)&&d.startAt is int&&d.endAt is int&&d.endAt>d.startAt&&d.registrationDeadline is int&&d.registrationDeadline>=0&&d.registrationDeadline<=d.startAt&&d.fee is int&&d.fee>=0&&d.fee<=10000000000&&d.published is bool;}
    allow read:if staff(c)||resource.data.published==true;
    allow create:if staff(c)&&valid()&&createStamp();allow update:if staff(c)&&valid()&&updateStamp();allow delete:if false;
    match /registrations/{uid}{
     function valid(){let d=request.resource.data;return d.keys().hasOnly(['name','email','studentId','phone','note','checkedIn','paid','createdAt','updatedAt','createdBy'])&&title(d.name)&&text(d.email,254)&&text(d.studentId,40)&&text(d.phone,40)&&text(d.note,2000)&&d.checkedIn is bool&&d.paid is bool;}
     allow read:if staff(c)||(signed()&&request.auth.uid==uid);
     allow create:if signed()&&request.auth.uid==uid&&event().published==true&&event().startAt>request.time.toMillis()&&(event().registrationDeadline==0||event().registrationDeadline>=request.time.toMillis())&&valid()&&createStamp()&&request.resource.data.email==request.auth.token.email&&request.resource.data.checkedIn==false&&request.resource.data.paid==false;
     allow update:if staff(c)&&valid()&&updateStamp()&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checkedIn','paid','updatedAt']);
     allow delete:if false;
    }
    match /forms/{id}{
     function valid(){let d=request.resource.data;return id=='feedback'&&d.keys().hasOnly(['title','questions','open','createdAt','updatedAt','createdBy'])&&title(d.title)&&d.questions is list&&d.questions.size()<=8&&d.open is bool;}
     allow read:if module(c,'feedback')&&(staff(c)||event().published==true);
     allow create:if module(c,'feedback')&&staff(c)&&valid()&&createStamp();allow update:if module(c,'feedback')&&staff(c)&&valid()&&updateStamp();allow delete:if false;
    }
    match /responses/{uid}{
     function valid(){let d=request.resource.data;return d.keys().hasOnly(['rating','comment','answers','createdAt','updatedAt','createdBy'])&&d.rating is int&&d.rating>=1&&d.rating<=5&&text(d.comment,5000)&&d.answers is map&&d.answers.size()<=8;}
     allow read:if module(c,'feedback')&&(staff(c)||(signed()&&request.auth.uid==uid));
     allow create:if module(c,'feedback')&&signed()&&request.auth.uid==uid&&event().published==true&&exists(/databases/$(database)/documents/clubs/$(c)/events/$(e)/registrations/$(uid))&&get(/databases/$(database)/documents/clubs/$(c)/events/$(e)/forms/feedback).data.open==true&&valid()&&createStamp();
     allow update,delete:if false;
    }
   }
   match /transactions/{id}{
    function valid(){let d=request.resource.data;return d.keys().hasOnly(['title','type','amount','date','category','eventId','note','createdAt','updatedAt','createdBy'])&&title(d.title)&&d.type in ['income','expense']&&d.amount is int&&d.amount>0&&d.amount<=10000000000&&text(d.date,10)&&text(d.category,100)&&text(d.eventId,100)&&text(d.note,5000);}
    allow read:if finance(c);allow create:if finance(c)&&valid()&&createStamp();allow update:if finance(c)&&valid()&&updateStamp();allow delete:if core(c);
   }
   match /inventory/{id}{
    function valid(){let d=request.resource.data;return d.keys().hasOnly(['name','unit','location','quantity','note','lastMovementId','createdAt','updatedAt','createdBy'])&&title(d.name)&&text(d.unit,20)&&text(d.location,200)&&text(d.note,2000)&&d.quantity is int&&d.quantity>=0&&d.quantity<=1000000&&text(d.lastMovementId,100);}
    function paired(){let d=request.resource.data;let m=getAfter(/databases/$(database)/documents/clubs/$(c)/inventoryMovements/$(d.lastMovementId)).data;return d.lastMovementId!=resource.data.lastMovementId && !exists(/databases/$(database)/documents/clubs/$(c)/inventoryMovements/$(d.lastMovementId)) && m.itemId==id && m.before==resource.data.quantity && m.after==d.quantity && m.delta==d.quantity-resource.data.quantity;}
    allow read:if module(c,'inventory')&&staff(c);
    allow create:if module(c,'inventory')&&staff(c)&&valid()&&createStamp()&&request.resource.data.quantity==0&&request.resource.data.lastMovementId=='';
    allow update:if module(c,'inventory')&&staff(c)&&valid()&&updateStamp()&&((request.resource.data.quantity==resource.data.quantity&&request.resource.data.lastMovementId==resource.data.lastMovementId)||paired());
    allow delete:if false;
   }
   match /inventoryMovements/{id}{
    function valid(){let d=request.resource.data;let old=get(/databases/$(database)/documents/clubs/$(c)/inventory/$(d.itemId)).data;let next=getAfter(/databases/$(database)/documents/clubs/$(c)/inventory/$(d.itemId)).data;return d.keys().hasOnly(['itemId','before','after','delta','reason','createdAt','updatedAt','createdBy'])&&d.delta is int&&d.delta!=0&&d.before==old.quantity&&d.after==next.quantity&&d.after==d.before+d.delta&&next.lastMovementId==id&&title(d.reason);}
    allow read:if module(c,'inventory')&&staff(c);allow create:if module(c,'inventory')&&staff(c)&&valid()&&createStamp();allow update,delete:if false;
   }
   match /blindStructures/{id}{
    function valid(){let d=request.resource.data;return d.keys().hasOnly(['title','text','createdAt','updatedAt','createdBy'])&&title(d.title)&&text(d.text,10000);}
    allow read:if module(c,'timer')&&staff(c);allow create:if module(c,'timer')&&staff(c)&&valid()&&createStamp();allow update:if module(c,'timer')&&staff(c)&&valid()&&updateStamp();allow delete:if module(c,'timer')&&staff(c);
   }
  }
 }
}
